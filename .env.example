# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Database password for the Compose-managed PostgreSQL (required).
POSTGRES_PASSWORD=

# Password for the web dashboard login. Use a long random value (required for `--profile app`).
APP_PASSWORD=

# Secret used to sign session cookies. Use at least 32 random characters, for example: openssl rand -hex 32
SESSION_SECRET=

# Host address the dashboard binds to. Loopback by default; set a LAN address only behind a TLS reverse proxy.
APP_BIND_IP=127.0.0.1

# Connection string for running tests and the CLI from the host (the database is published on 127.0.0.1:55432).
# DATABASE_URL=postgres://portfolio:<POSTGRES_PASSWORD>@127.0.0.1:55432/portfolio

# Seconds between refreshes when running the optional `scheduler` profile (default 86400).
# REFRESH_INTERVAL_SECONDS=86400

# Seconds between intraday price refreshes when running the optional `live` profile (default 300).
# LIVE_REFRESH_INTERVAL_SECONDS=300
